# Public, client-safe configuration only. Never put secrets here.
# Server-side API base (preferred for server components / route handlers).
API_URL=http://localhost:4000
# Public API base (used by client components).
NEXT_PUBLIC_API_URL=http://localhost:4000
# Public site origin (canonical URLs, metadata).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=omincalc

# Control Center (/control-center) needs no frontend credentials: sign-in is
# verified by the backend (Supabase Auth) and the session is held in httpOnly
# cookies (cc_at / cc_rt) set by the login server action. Never add Supabase
# keys, service-role secrets or admin credentials to this file.

# ── DEV-ONLY Admin bypass (default false) ────────────────────────────────────
# Opens /control-center with no login: the middleware stops redirecting to
# /login and the session check accepts the backend's synthetic super_admin
# identity. For reviewing the Admin UI without seeded credentials.
#
# Requires the matching backend flag ADMIN_BYPASS_AUTH=true — both ends must
# agree. Ignored when NODE_ENV=production, and the backend refuses to boot
# with its flag set in production, so this cannot ship open.
# NEXT_PUBLIC_* is inlined at build time: changing it needs a rebuild.
NEXT_PUBLIC_ADMIN_BYPASS=false

# Feature flags (Step 40). Public, non-secret. Anything other than "true"/
# "false" falls back to the default noted below.
# Live score surfaces (opt-in; default false).
NEXT_PUBLIC_FEATURE_LIVE=false
# Phase 1 content surfaces (default true — only "false" disables them).
NEXT_PUBLIC_FEATURE_BREAKING=true
NEXT_PUBLIC_FEATURE_TRANSFERS=true
NEXT_PUBLIC_FEATURE_SEARCH=true
# Mobile bottom quick-navigation (default true).
NEXT_PUBLIC_FEATURE_BOTTOM_NAV=true
