# Vercel environment - variable names only, NO secret values.
# Copy into Vercel Dashboard -> Project -> Settings -> Environment Variables (Production).
# Single deployment: public site + /api/v1 API + Admin panel are ONE Vercel project.
# Never commit real values. See VERCEL_FULLSTACK_SETUP.md.

# -- PUBLIC (NEXT_PUBLIC_* - inlined into client JS at build time) ----------------
# Required. Canonical site origin, must be https://, no trailing slash.
# Drives canonical URLs, robots.txt, sitemaps and the server-side API base
# (same origin). Non-sensitive by design - it is the site's public address.
NEXT_PUBLIC_SITE_URL=https://football-121.vercel.app
# Optional. Leave EMPTY on Vercel: the API is this same deployment, so the
# browser calls the same-origin /api/v1/* path. Only set if the API moves
# to another host.
NEXT_PUBLIC_API_URL=
# Optional. Defaults to "Football".
NEXT_PUBLIC_SITE_NAME=
# Optional feature flags (defaults noted in frontend/.env.example).
NEXT_PUBLIC_FEATURE_LIVE=
NEXT_PUBLIC_FEATURE_BREAKING=
NEXT_PUBLIC_FEATURE_TRANSFERS=
NEXT_PUBLIC_FEATURE_SEARCH=
NEXT_PUBLIC_FEATURE_BOTTOM_NAV=
# DEV-ONLY. Must be false or UNSET on Vercel production (forced false when NODE_ENV=production).
NEXT_PUBLIC_ADMIN_BYPASS=

# -- SERVER-ONLY (SSR / route handlers / middleware - never NEXT_PUBLIC_) ---------
# Optional. Internal API base for server components + the /sitemap.xml proxy.
# Leave EMPTY on Vercel: falls back to NEXT_PUBLIC_SITE_URL (same origin).
API_URL=

# -- BACKEND (runs as the /api/v1 serverless function of THIS deployment) --------
# All server-only. Read inside the Vercel function; never NEXT_PUBLIC_.
# PORT / NODE_ENV are managed by Vercel - do not set.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Server-only. REQUIRED in production. Same-origin POST/PUT/PATCH still send an
# Origin header, so the Express allowlist must include the deployment origin.
# Comma-separate to add preview/custom domains. Never '*'.
CORS_ORIGINS=https://football-121.vercel.app
# Server-only. REQUIRED in production. Canonical origin used by backend SEO
# (sitemap <loc>, robots Host/Sitemap). Same value as NEXT_PUBLIC_SITE_URL.
# Keep explicit: Vercel's VERCEL_URL is the per-deployment hostname, not the
# stable canonical origin, so it must NOT replace this.
SITE_BASE_URL=https://football-121.vercel.app
SITE_NAME=
# Must stay false/unset in production (the function refuses to boot otherwise).
ADMIN_BYPASS_AUTH=false
# Optional tuning (sane defaults ship in backend/src/config.ts):
# TRUST_PROXY_HOPS=1
# PAGINATION_DEFAULT_LIMIT=20
# PAGINATION_MAX_LIMIT=100
# RATE_LIMIT_PUBLIC_MAX=120
# RATE_LIMIT_AUTHED_MAX=600
# CACHE_TTL_STATIC=300
# CACHE_TTL_NEWS=60
# CACHE_TTL_MATCHES=30
# MEDIA_BUCKET=media
# MEDIA_MAX_UPLOAD_BYTES=5000000
# SEO_SITEMAP_MAX_URLS=5000
# SEO_NEWS_WINDOW_HOURS=48
# External football-data provider (OPTIONAL). Only required when
# PROVIDER_ENABLED=true; the site boots fine without them.
# PROVIDER_ENABLED=false
# PROVIDER_BASE_URL=
# PROVIDER_API_KEY=
# PROVIDER_KEY_HEADER=X-Api-Key
# Full template: backend/.env.example (placeholders only).
