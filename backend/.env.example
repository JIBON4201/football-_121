# Supabase (server-side only — never expose SERVICE_ROLE key to the frontend)
SUPABASE_URL=https://xyzcompany.supabase.co
SUPABASE_ANON_KEY=public-anon-key
SUPABASE_SERVICE_ROLE_KEY=service-role-key-keep-secret

PORT=4000
NODE_ENV=development

# Comma-separated allowlist, e.g. https://football.example.com,https://www.football.example.com
CORS_ORIGINS=http://localhost:3000

# ── DEV-ONLY Admin bypass (default false) ────────────────────────────────────
# Grants every /api/v1/admin/* request a synthetic super_admin identity, so
# requireAdmin/requirePermission stop enforcing and no Bearer token is needed.
# For reviewing the Admin UI without a seeded admin account.
#
# !! This disables ALL Admin authorization. It is refused at boot when
# !! NODE_ENV=production, ignored at the point of use in production, and
# !! reported as a BLOCKER by `npm run verify`. Never set this on a deployed
# !! environment. Requires NEXT_PUBLIC_ADMIN_BYPASS=true on the frontend too.
ADMIN_BYPASS_AUTH=false

# Pagination
PAGINATION_DEFAULT_LIMIT=20
PAGINATION_MAX_LIMIT=100

# Rate limiting (requests per minute)
RATE_LIMIT_PUBLIC_MAX=120
RATE_LIMIT_AUTHED_MAX=600

# Public cache TTLs (seconds)
CACHE_TTL_STATIC=300
CACHE_TTL_MATCHES=30
CACHE_TTL_NEWS=60

# Media processing (Step 27) — no secrets here
MEDIA_BUCKET=media
MEDIA_CDN_BASE_URL=
MEDIA_MAX_UPLOAD_BYTES=5000000
MEDIA_ALLOWED_MIME=image/jpeg,image/png,image/webp,image/avif
MEDIA_ALLOW_AVIF=true
MEDIA_MAX_DIMENSION=8000
MEDIA_IMAGE_QUALITY=80
MEDIA_PROCESSING_TIMEOUT_MS=30000
MEDIA_UPLOAD_RATE_LIMIT=30
MEDIA_CACHE_MAX_AGE=31536000

# ── Football provider (Step 40) ─────────────────────────────────────────────
# Read by providerConfigFromEnv('<PREFIX>'). Credentials are server-side only:
# they must never be written to the database, logs, or any HTTP response.
# These are REQUIRED (BLOCKER) when NODE_ENV=production — see src/lib/envRules.ts
PROVIDER_BASE_URL=https://api.vendor.example/v3
PROVIDER_API_KEY=replace-with-real-provider-key
PROVIDER_KEY_HEADER=X-Api-Key
PROVIDER_TIMEOUT_MS=10000
PROVIDER_MAX_RETRIES=3
PROVIDER_REQUESTS_PER_MINUTE=60
PROVIDER_MAX_RESPONSE_BYTES=5000000
PROVIDER_ENABLED=false

# Optional: administrative token used only by the Step 40 verification CLI to
# read worker/scheduler health endpoints. Never required by the public site.
# ADMIN_TOKEN=

# ── Worker / scheduler (Step 40) ─────────────────────────────────────────────
# Tuned via CLI flags, not env. Documented here so the runtime contract is
# discoverable in one place:
#   npm run worker    -- --poll 2000 --lease 120000 --provider-interval 1000 \
#                        --shutdown-timeout 60000
#   npm run scheduler -- --interval 60 --once
# Both processes call assertEnvIsSane() and refuse to start in production
# when the environment above is incomplete.

# Site & SEO discovery (Step 28) — public values only, no secrets
SITE_BASE_URL=https://football.example.com
SITE_NAME=Football
SITE_LANGUAGE=en
SEO_DEFAULT_DESCRIPTION=Football news, fixtures, results, teams, players and competitions.
SEO_DEFAULT_IMAGE=/og-default.png
SEO_TWITTER_SITE=
SEO_SITEMAP_MAX_URLS=5000
SEO_NEWS_WINDOW_HOURS=48
SEO_CACHE_TTL=3600
