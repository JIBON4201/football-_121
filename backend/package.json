{
  "name": "football-api",
  "version": "1.0.0",
  "private": true,
  "description": "Production backend/API foundation for the Football website (API v1).",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "import": "tsx --env-file-if-exists=.env src/cli/import.ts",
    "worker": "tsx --env-file-if-exists=.env src/cli/worker.ts",
    "scheduler": "tsx --env-file-if-exists=.env src/cli/scheduler.ts",
    "verify": "tsx --env-file-if-exists=.env src/verify/cli.ts",
    "import:dataset": "tsx --env-file-if-exists=.env src/cli/import-dataset.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.44.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "hyparquet": "^1.31.2",
    "sanitize-html": "2.17.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.0",
    "@types/sanitize-html": "^2.16.2",
    "@types/supertest": "^6.0.2",
    "supertest": "^6.3.4",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": "22.x"
  }
}
